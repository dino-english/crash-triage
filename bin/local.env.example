# ── 机器本地配置样例 ──────────────────────────────────────────────────
# 拷到 $STATE/local.env 后按本机身份改值（$STATE = ${XDG_STATE_HOME:-~/.local/state}/crash-triage）。
#
#   cp bin/local.env.example "${XDG_STATE_HOME:-$HOME/.local/state}/crash-triage/local.env"
#
# 与 path.env 的分工（path.env 是 2026-08-20 起的新名，旧名 config.env）：
#   path.env    由 setup.sh 探测生成（只有 PATH），install.sh / update.sh 每次重跑都整个覆写
#   local.env   人手写，任何脚本都不覆写它 —— 配置写这里才留得住
#
# 加载点在 crash-daily.sh / crash-weekly.sh / deliver.sh / diag-hourly.sh / diag-backfill.sh，**位置在解析 CHAT_ID 之前**，
# 所以这里的赋值会盖掉命令行传入的同名环境变量。这是刻意的：投递目标由机器决定，
# 不由手打的命令决定（2026-08-20 一次测试差点把卡片发进正式群）。
# deliver.sh 还会用它压过 manifest 里记的 chat_id，挡住「拿别处的 manifest 在本机补投」。

# 投递目标。ou_ = 私聊（开发机自测用），oc_ = 群（只有生产机该填这个）。
# ⚠️ open_id 按 app 隔离，跨 app 用会报 99992361；群 ID 是租户级的不受影响。
export CRASH_REPORT_CHAT_ID="ou_你的open_id"   # export 是必须的：alert.sh / deliver.sh 是子进程

# 可选：投递身份，默认 bot（user 身份 refresh token 会过期，无人值守必挂）
# export CRASH_REPORT_LARK_AS="bot"

# L0 每小时技术诊断告警的投递目标（change crash-tech-diagnostics）。⚠️ 只从本文件读，命令行设了也被忽略；
# 不设 → L0 照常计算、不投递，⛔ 不回落到上面的 CRASH_REPORT_CHAT_ID。生产机填日报群（维护者 2026-11-27 定）；开发机填维护者 ou_ 私聊。
# export CRASH_REPORT_DIAG_ALERT_CHAT_ID="oc_<只有维护者一人的测试群 chat_id>"   # 或 ou_ 私聊：⚠️ 要用本机发卡应用下的 open_id，不同应用的 ID 不通用

# 技术诊断的 PostHog 只读 key（App 从 iOS 2.1.2 / Android 2.1.1 起把诊断改发 PostHog Logs）。⚠️ 本文件要 chmod 600；
# ⛔ 写成普通赋值、不 export：只有主进程用它，export 会进 claude -p / MCP / lark-cli 等所有子进程的环境
# CRASH_REPORT_POSTHOG_API_KEY="phx_<PostHog 只读 Personal API Key>"
