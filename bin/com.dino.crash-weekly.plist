<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.dino.crash-weekly</string>

    <!-- L2 每周变化播报：Firebase MCP + git 反查 → 飞书。
         Weekday 1 = 周一（0/7 = 周日）。改时间只改 Hour/Minute/Weekday。
         05:30 而非 06:30：完整 triage 实测跑 12 分钟以上，需与 07:00 的 L1 留足间隔，
         否则两者同时调 lark-cli 会加剧限流（2026-08-07 已撞过 429）。 -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>1</integer>
        <key>Hour</key>
        <integer>5</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <!-- 安装时把 USER 替换成实际用户名 -->
        <string>/Users/USER/crash-triage/bin/crash-weekly.sh</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>CRASH_REPORT_ROOT</key>
        <string>/Users/USER/crash-triage</string>
        <key>CRASH_REPORT_CHAT_ID</key>
        <string>oc_655033f1f85fa04f9eac25d56f056fc9</string>
        <!-- 换 agent 改这里：claude / cursor-agent / codex -->
        <key>AGENT_CMD</key>
        <string>claude</string>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/USER/crash-triage/logs/launchd-weekly.out</string>
    <key>StandardErrorPath</key>
    <string>/Users/USER/crash-triage/logs/launchd-weekly.err</string>
</dict>
</plist>
